# Copy to .env and fill in real values. .env is gitignored.

# --- Service ---
HOST=127.0.0.1
PORT=28080
LOG_LEVEL=INFO

# --- ASR (Aliyun short-sentence recognition) ---
# Console: https://nls-portal.console.aliyun.com/
ASR_PROVIDER=aliyun
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_NLS_APPKEY=
# Token endpoint region; "cn-shanghai" is the default for NLS
ALIYUN_NLS_REGION=cn-shanghai

# --- LLM (iFlytek MaaS, OpenAI-compatible) ---
# Console: https://training.xfyun.cn/modelService
LLM_PROVIDER=xfyun
XFYUN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_MODEL_ID=
XFYUN_RESOURCE_ID=0

# --- TTS (Microsoft Edge, no key needed) ---
TTS_PROVIDER=edge
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# --- Router adapter ---
# mock = no real device, just log the action
# openwrt = SSH into an OpenWrt box and run commands
ROUTER_PROVIDER=mock
ROUTER_HOST=192.168.1.1
ROUTER_PORT=22
ROUTER_USER=root
# Either a password or a private key file path. Prefer the key.
ROUTER_PASSWORD=
ROUTER_KEY_PATH=

# --- Self-heal ---
# Hosts to ping; comma-separated
SELFHEAL_PING_TARGETS=8.8.8.8,114.114.114.114
SELFHEAL_INTERVAL_SECONDS=30
SELFHEAL_FAILURE_THRESHOLD=3
# If true, ask for spoken confirmation before doing anything irreversible
SELFHEAL_REQUIRE_CONFIRMATION=true
